{
  "name": "__FRONTEND_PACKAGE__",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{vue,scss}\"",
