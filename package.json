{
  "name": "@yangxj96/spring-vue-stack",
  "version": "1.2.1",
  "description": "Portable Agent Skills package and scaffolder for Spring Boot 4 + Vue 3 projects.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "spring-vue-stack": "bin/spring-vue-stack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "integrations",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent-skills",
    "opencode",
    "spring-boot",
    "vue",
    "scaffold",
    "cli",
    "mybatis-plus",
    "postgresql",
    "redis"
  ],
  "scripts": {
    "start": "node bin/spring-vue-stack.mjs",
    "validate": "node skills/spring-vue-stack/scripts/validate.mjs",
    "init": "node skills/spring-vue-stack/scripts/init.mjs",
    "scaffold": "node skills/spring-vue-stack/scripts/scaffold.mjs",
    "test": "node --test",
    "verify": "npm run validate && npm test && node scripts/verify-install.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0"
  }
}
